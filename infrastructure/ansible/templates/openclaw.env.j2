{% for key in lookup('pipe', 'env | cut -d= -f1 | grep ^OPENCLAW_ || true').splitlines() %}
{% if key not in ['GH_TOKEN', 'OPENCLAW_CLUSTER_TOKEN', 'OPENCLAW_GITHUB_TOKEN', 'OPENCLAW_DISCORD_BOT_TOKEN_RAHUL'] and not key.startswith('OPENCLAW_TELEGRAM_') and not key.startswith('RAHUL_') %}
{{ key }}="{{ lookup('env', key) }}"
{% endif %}
{% endfor %}
OPENROUTER_API_KEY={{ lookup('env', 'OPENROUTER_API_KEY') }}
NVIDIA_API_KEY={{ lookup('env', 'NVIDIA_API_KEY') }}
